# ============================================================================
# CodeInsight Agent 环境变量模板
# 用法：复制本文件为 .env，按需修改
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ============================================================================

# ---------------- 服务 ----------------
APP_NAME=CodeInsight Agent
HOST=127.0.0.1
PORT=8000

# ---------------- LLM（Ollama）----------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 建议用指令跟随能力强的模型，ReAct 的 Thought/Action 格式才稳
# 实测 deepseek-r1 蒸馏小模型（1.5b）基本不调用工具，会直接编答案
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=300

# ---------------- Embedding ----------------
# sentence_transformers：本地跑 bge-small-zh（默认，需要装 sentence-transformers）
# ollama：走 Ollama 的 /api/embed，省掉 torch；此时 EMBEDDING_MODEL 要填 Ollama 里的模型名
#
# 注意：国内网络访问 huggingface.co 会超时，首次运行（要下载 Embedding 模型）前先设镜像。
# 这一项不是 .env 的配置项，必须在 shell 里设成环境变量：
#   Windows:      $env:HF_ENDPOINT='https://hf-mirror.com'
#   macOS/Linux:  export HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 必须与 EMBEDDING_MODEL 的输出维度一致（bge-small-zh-v1.5 = 512）
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32

# ---------------- 向量库 ----------------
CHROMA_DIR=./data/chroma
COLLECTION_NAME=code_chunks

# ---------------- 检索 ----------------
RECALL_N=20
TOP_K=5

# ---------------- Agent ----------------
MAX_AGENT_STEPS=8
# 是否允许 write_comment 工具真正改写源文件；默认 false，只返回 diff 预览
ALLOW_WRITE=false

# ---------------- 代码库 ----------------
# 被索引的目标代码目录（调用 /index 接口时会被动态覆盖）
REPO_ROOT=.

# ---------------- 索引 ----------------
INCLUDE_EXT=.py,.java,.md
EXCLUDE_DIRS=.git,.idea,.venv,venv,__pycache__,node_modules,dist,build,target,.pytest_cache,.mypy_cache,.ruff_cache,site-packages
MAX_FILE_SIZE_KB=512
MAX_CHUNK_LINES=120